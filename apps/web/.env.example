# Server-side only. Never expose this key in client code.
OPENAI_API_KEY=
# Current default model for efficient note assistance and handwriting recognition.
OPENAI_MODEL=gpt-6-luna
# Set false to disable all paid AI endpoints without redeploying code.
INTEGRATE_AI_ENABLED=true
# Basic per-instance abuse controls. Use stronger edge/account limits when accounts launch.
AI_RATE_LIMIT_PER_MINUTE=12
RECOGNITION_RATE_LIMIT_PER_MINUTE=8
# Displayed by /api/health for deployment verification.
NEXT_PUBLIC_APP_VERSION=0.9.0-rc.1
